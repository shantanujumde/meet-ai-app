__pycache__/
*.pyc
.DS_Store

# Paperclip local instance data (db, logs, secrets)
.paperclip/
# Anchored: an unanchored `bin/` would also swallow crates/audio/src/bin/.
/bin/

# Rust
/target/

# Node
node_modules/
dist/

# Tauri generated
src-tauri/gen/
# The Vulkan loader shipped beside meet-ai.exe on Windows (TUR-61), copied
# from the Vulkan SDK by check.yml; never committed.
src-tauri/vulkan/

# Signing keys. Never commit one — the updater private key lives in secure
# custody, not in the repo (SETUP.md step 1.2).
*.key
*.p12

# Audio fixtures: the generator IS source, so ignore the artifacts rather than
# the whole directory — an unqualified `fixtures/` swallowed generate.sh and
# made the fixtures unreproducible on a fresh clone.
#
# `segments/` is the exception. Those are `segments.json` files of a few tens of
# KB, and `crates/audio/tests/segments_fixtures.rs` parses them from disk — the
# on-disk shape is half of what the test asserts, so the fixtures have to be in
# the tree for `cargo test` to mean anything on a fresh clone. Their WAVs are
# still generated (FIXTURE_WAVS=1) and still ignored, by the `*.wav` rule below.
#
# The SPEC §6 speech and silence fixtures are committed too (TUR-50): they are
# made with macOS `say`, so a Windows or Linux runner cannot make them. They
# are un-ignored by name after the `*.wav` rule below.
crates/audio/fixtures/*
!crates/audio/fixtures/generate.sh
!crates/audio/fixtures/generate-segments.py
!crates/audio/fixtures/segments/
!crates/audio/fixtures/two-speaker-60s/

# Recordings and transcripts never belong in the repo.
Meetings/
!src-tauri/src/meetings/
*.wav
# ...except the committed fixture WAVs named above (TUR-50).
!crates/audio/fixtures/silence-30s.wav
!crates/audio/fixtures/room-tone-30s.wav
!crates/audio/fixtures/two-speaker-60s/mic.wav
!crates/audio/fixtures/two-speaker-60s/system.wav
# ...except store's hand-written fixture root. macOS is case-insensitive and
# git runs with core.ignorecase there, so `Meetings/` above also matches this
# lowercase `meetings/` and silently kept the TUR-99 gate fixtures out of main.
!crates/store/tests/fixtures/meetings/

# Spike build output (compiled binaries + signed bundle) is reproducible from
# source via spikes/phase0a-tcc/build.sh.
spikes/*/build/

# Brand raster staging. Reproducible from design-system/meet-ai/brand/tools via
# `node build.mjs && ./render.sh`; the committed outputs are src-tauri/icons/,
# public/, and the SVG masters.
#
# src-tauri/icons/Assets.car is committed too, for a different reason: it is
# compiled from design-system/meet-ai/brand/meet-ai.icon by `just icon-car`, and
# that needs Xcode 26+ (actool). Committing the compiled catalog is what keeps
# routine builds on Command Line Tools only (SPEC A10). actool's other outputs
# (partial Info.plist, its own .icns) go to a temp dir and never land here.
design-system/meet-ai/brand/tools/.render/

# graphify knowledge graph and its cache. Regenerated locally by
# `graphify update .`, so it never belongs in the repo.
graphify-out/

.scratch