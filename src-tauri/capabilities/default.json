{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window (TUR-158): only what its own JS calls. Plugins Rust drives itself (notifications, the shortcut, the updater, os, opening settings panes) need nothing here. Its two links (the model credit, the Whisper language list) are the only URLs it may open; every other URL goes through a command that checks it. App commands are checked too, because build.rs declares them (src/app_commands.rs).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-message",
    "log:allow-log",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://huggingface.co/nvidia/*" },
        { "url": "https://github.com/openai/whisper*" }
      ]
    },
    "allow-list-meetings",
    "allow-read-meeting",
    "allow-save-notes",
    "allow-rename-meeting",
    "allow-change-meetings-folder",
    "allow-reveal-meeting",
    "allow-delete-meeting",
    "allow-measure-permission",
    "allow-permission-quick",
    "allow-open-privacy-settings",
    "allow-onboarding-state",
    "allow-complete-onboarding",
    "allow-reset-onboarding",
    "allow-engine-environment",
    "allow-engine-selection",
    "allow-model-catalogue",
    "allow-download-model",
    "allow-delete-model",
    "allow-engine-choices",
    "allow-model-credits",
    "allow-set-transcription",
    "allow-set-spoken-language",
    "allow-recording-status",
    "allow-toggle-recording",
    "allow-stop-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-live-transcript",
    "allow-list-tickets",
    "allow-create-ticket",
    "allow-start-work-prompt",
    "allow-wrap-up-prompt",
    "allow-copy-prompt-fallback",
    "allow-agent-choice",
    "allow-detect-agents",
    "allow-save-agent-choice",
    "allow-test-agent",
    "allow-cancel-agent-test",
    "allow-notes-auto-run",
    "allow-save-notes-auto-run",
    "allow-search",
    "allow-notes-run-status",
    "allow-start-notes-run",
    "allow-cancel-notes-run",
    "allow-meeting-notes",
    "allow-sync-task",
    "allow-cancel-sync",
    "allow-dismiss-unsaved-sync",
    "allow-meeting-tasks",
    "allow-open-synced-issue",
    "allow-approve-task",
    "allow-approve-all-tasks",
    "allow-discard-task",
    "allow-tracker-settings",
    "allow-set-tracker",
    "allow-tracker-servers",
    "allow-ticket-sync-states",
    "allow-retry-ticket-sync",
    "allow-send-test-ticket",
    "allow-set-meeting-notes",
    "allow-todays-meetings",
    "allow-calendar-refresh-minutes",
    "allow-calendar-accounts",
    "allow-calendar-sources",
    "allow-set-calendar-app",
    "allow-calendar-connect",
    "allow-calendar-disconnect",
    "allow-meeting-brief",
    "allow-audio-retention-days",
    "allow-confirm-quit",
    "allow-app-settings",
    "allow-set-show-in-dock-when-closed",
    "allow-open-logs-folder",
    "allow-menu-bar-countdown",
    "allow-set-menu-bar-countdown",
    "allow-builtin-mic-with-bluetooth",
    "allow-set-builtin-mic-with-bluetooth",
    "allow-notification-settings",
    "allow-set-notification-settings",
    "allow-os-notifications-blocked",
    "allow-open-notification-settings",
    "allow-send-test-reminder",
    "allow-never-detect-apps",
    "allow-set-never-detect-apps",
    "allow-join-reminded-meeting",
    "allow-record-reminded-meeting",
    "allow-record-shortcut-available",
    "allow-start-at-login",
    "allow-set-start-at-login",
    "allow-appearance-settings",
    "allow-set-appearance",
    "allow-headphone-warning",
    "allow-meetings-watch-problem",
    "allow-show-recording-overlay",
    "allow-set-show-recording-overlay",
    "allow-config-problem"
  ]
}
